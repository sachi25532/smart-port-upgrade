sv import from ..services.portOperations { getPortSnapshot, resetSimulation, advanceSimulation, injectCraneFailure, restoreCrane, runBerthReplanner, approveSchedule }


def:pub PortMindDashboard() -> JsxElement {
    has minute: int = 0,
        vessel_x: int = 18,
        crane_failed: bool = False,
        cargo_progress: int = 40,
        plan_ready: bool = False,
        plan_approved: bool = False,
        berth: str = "Berth 01",
        message: str = "Connecting to synthetic port simulation…",
        speed: int = 1;

    async can with entry {
        snapshot = await getPortSnapshot();
        minute = snapshot["minute"] as int;
        vessel_x = snapshot["vessel_x"] as int;
        crane_failed = snapshot["crane_failed"] as bool;
        cargo_progress = snapshot["cargo_progress"] as int;
        plan_ready = snapshot["plan_ready"] as bool;
        plan_approved = snapshot["plan_approved"] as bool;
        berth = snapshot["berth"] as str;
        message = "Persistent Jac graph state loaded.";
    }

    async def load_snapshot() -> None {
        snapshot = await getPortSnapshot();
        minute = snapshot["minute"] as int;
        vessel_x = snapshot["vessel_x"] as int;
        crane_failed = snapshot["crane_failed"] as bool;
        cargo_progress = snapshot["cargo_progress"] as int;
        plan_ready = snapshot["plan_ready"] as bool;
        plan_approved = snapshot["plan_approved"] as bool;
        berth = snapshot["berth"] as str;
    }
    async def do_reset() -> None { _snapshot = await resetSimulation(); await load_snapshot(); message = "Simulation reset in persistent graph state."; }
    async def do_advance() -> None { _snapshot = await advanceSimulation(15 * speed); await load_snapshot(); message = "Simulation advanced; vessel and cargo state recalculated by Jac."; }
    async def do_fail() -> None { _snapshot = await injectCraneFailure(); await load_snapshot(); message = "Crane QC-04 failure recorded; cargo rate is now zero until restored."; }
    async def do_restore() -> None { _snapshot = await restoreCrane(); await load_snapshot(); message = "Crane QC-04 restored in graph state."; }
    async def do_replan() -> None { _snapshot = await runBerthReplanner(); await load_snapshot(); message = "Deterministic berth replanner produced a proposal."; }
    async def do_approve() -> None { _snapshot = await approveSchedule(); await load_snapshot(); message = "Schedule approval recorded when a proposal exists."; }
    def change_speed(e: MouseEvent) { speed = 5 if speed == 1 else 1; }

    return <div className="min-h-screen bg-[#07111d] text-slate-100"><header className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 bg-[#091522] px-5 py-4"><div className="flex items-center gap-3"><div className="flex size-10 items-center justify-center rounded border border-cyan-400/30 bg-cyan-400/10 font-bold text-cyan-300">P</div><div><div className="text-sm font-bold tracking-wide">PORTMIND <span className="text-cyan-300">AI</span> / COLOMBO</div><div className="text-[10px] text-slate-500">Synthetic Port Operations Command</div></div></div><div className="flex items-center gap-2 text-[10px]"><span className="rounded border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-emerald-300">JAC GRAPH CONNECTED</span><span className="rounded border border-cyan-500/30 px-2 py-1 text-cyan-200">SIM {"14:" + ("0" if minute < 10 else "") + str(minute)} UTC</span></div></header>
      <main className="mx-auto flex w-full max-w-[1500px] flex-col gap-4 p-4 md:p-6"><div className="flex flex-wrap items-end justify-between gap-3"><div><p className="text-[10px] font-semibold uppercase tracking-[.2em] text-cyan-400">Colombo Simulation Terminal · Test Run 01</p><h1 className="mt-1 text-2xl font-semibold tracking-tight">Operational workflow verification</h1><p className="mt-1 text-xs text-slate-400">Persistent Jac graph-backed vessel, crane, cargo and schedule state</p></div><div className="flex flex-wrap gap-2"><button onClick={do_reset} className="rounded border border-slate-700 px-3 py-2 text-xs hover:border-cyan-500">Reset</button><button onClick={do_advance} className="rounded bg-cyan-500 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-cyan-400">Advance time</button><button onClick={change_speed} className="rounded border border-slate-700 px-3 py-2 text-xs text-cyan-200">Speed {str(speed)}×</button></div></div>
      <div className="rounded border border-slate-800 bg-[#0c1a29] px-4 py-3 text-xs text-slate-300"><span className="mr-2 text-cyan-300">BACKEND RESPONSE</span>{message}</div>
      <section className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"><div className="rounded border border-slate-800 bg-[#0c1a29] p-4"><div className="text-[10px] uppercase tracking-wider text-slate-500">Vessel position</div><div className="mt-2 text-2xl font-semibold tabular-nums">X {str(vessel_x)}<span className="text-xs text-slate-500"> / 100</span></div><div className="mt-2 h-1.5 rounded bg-slate-700"><div className="h-1.5 rounded bg-cyan-400" style={{"width":str(vessel_x) + "%"}} /></div><div className="mt-2 text-[10px] text-slate-400">MV Ocean Pioneer · {berth}</div></div><div className="rounded border border-slate-800 bg-[#0c1a29] p-4"><div className="text-[10px] uppercase tracking-wider text-slate-500">Crane QC-04</div><div className={"mt-2 text-lg font-semibold " + ("text-red-300" if crane_failed else "text-emerald-300")}>{"FAILED" if crane_failed else "OPERATIONAL"}</div><div className="mt-1 text-[10px] text-slate-400">Cargo rate {"0" if crane_failed else "2"} units / simulated minute</div><button onClick={do_fail if not crane_failed else do_restore} className="mt-3 rounded border border-slate-700 px-3 py-1.5 text-[10px] hover:border-amber-400">{"Inject breakdown" if not crane_failed else "Restore crane"}</button></div><div className="rounded border border-slate-800 bg-[#0c1a29] p-4"><div className="text-[10px] uppercase tracking-wider text-slate-500">Cargo progress</div><div className="mt-2 text-2xl font-semibold tabular-nums">{str(cargo_progress)}%</div><div className="mt-2 h-1.5 rounded bg-slate-700"><div className="h-1.5 rounded bg-cyan-400" style={{"width":str(cargo_progress) + "%"}} /></div><div className="mt-2 text-[10px] text-slate-400">Progress changes on advance calls</div></div><div className="rounded border border-slate-800 bg-[#0c1a29] p-4"><div className="text-[10px] uppercase tracking-wider text-slate-500">Berth schedule</div><div className="mt-2 text-sm font-semibold">{berth}</div><div className="mt-1 text-[10px] text-slate-400">{"Approved" if plan_approved else ("Proposal ready" if plan_ready else "No pending proposal")}</div><div className="mt-3 flex flex-wrap gap-2"><button onClick={do_replan} className="rounded border border-cyan-500/30 px-2.5 py-1.5 text-[10px] text-cyan-200">Run berth replanner</button><button onClick={do_approve} className="rounded border border-emerald-500/30 px-2.5 py-1.5 text-[10px] text-emerald-200">Approve plan</button></div></div></section>
      <section className="grid gap-4 lg:grid-cols-[1fr_340px]"><div className="rounded border border-slate-800 bg-[#0b1927] p-4"><div className="flex flex-wrap items-start justify-between gap-2"><div><h2 className="text-sm font-semibold">Synthetic Colombo-inspired terminal</h2><p className="mt-1 text-[10px] text-slate-500">Schematic only · positions are simulation coordinates, not verified geographic data</p></div><span className="rounded border border-slate-700 px-2 py-1 text-[9px] text-slate-400">T+{str(minute)} min</span></div><div className="relative mt-4 h-64 overflow-hidden rounded border border-slate-700 bg-[#0a2434]"><div className="absolute inset-0 opacity-30" style={{"backgroundImage":"linear-gradient(rgba(68,140,166,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(68,140,166,.16) 1px,transparent 1px)","backgroundSize":"32px 32px"}} /><div className="absolute left-4 top-4 rounded border border-slate-700 bg-[#0d1c28] px-2 py-1 text-[9px] text-slate-400">APPROACH CHANNEL</div><div className="absolute left-[8%] top-[40%] h-px w-[72%] border-t border-dashed border-cyan-400/50" /><div className="absolute right-[8%] top-[14%] flex h-[72%] w-[34%] flex-col justify-around"><div className="rounded border border-slate-500 bg-slate-700/70 px-3 py-2 text-[10px]">BERTH 01 · {berth}</div><div className="rounded border border-slate-500 bg-slate-700/70 px-3 py-2 text-[10px]">BERTH 02 · AVAILABLE</div><div className="rounded border border-dashed border-cyan-500/60 bg-cyan-500/5 px-3 py-2 text-[10px] text-cyan-200">BERTH 03 · PROPOSED</div></div><div className="absolute top-[31%]" style={{"left":str(vessel_x) + "%"}}><div className="rounded border border-cyan-400/50 bg-[#081622] px-2 py-1 text-[9px] text-cyan-200">MV Ocean Pioneer</div><div className="ml-3 h-4 w-px bg-cyan-300" /></div><div className="absolute bottom-3 left-3 text-[9px] text-slate-500">Vessel position: {str(vessel_x)} / 100</div></div><div className="mt-3 flex flex-wrap gap-2"><button onClick={do_advance} className="rounded bg-cyan-500/15 px-3 py-2 text-xs text-cyan-200">Start / Advance</button><button onClick={do_reset} className="rounded border border-slate-700 px-3 py-2 text-xs text-slate-300">Reset to baseline</button></div></div>
      <aside className="rounded border border-slate-800 bg-[#0c1a29] p-4"><h2 className="text-sm font-semibold">Test sequence</h2><p className="mt-1 text-[10px] text-slate-500">Real endpoint calls; each action updates the graph snapshot.</p><ol className="mt-4 flex flex-col gap-3 text-xs"><li className="flex gap-2"><span className="text-cyan-300">01</span>Reset simulation state</li><li className="flex gap-2"><span className="text-cyan-300">02</span>Advance clock and move vessel</li><li className="flex gap-2"><span className="text-cyan-300">03</span>Inject crane fault</li><li className="flex gap-2"><span className="text-cyan-300">04</span>Confirm cargo rate stops</li><li className="flex gap-2"><span className="text-cyan-300">05</span>Replan and approve schedule</li><li className="flex gap-2"><span className="text-cyan-300">06</span>Advance after approval</li></ol><div className="mt-5 rounded border border-amber-500/20 bg-amber-500/5 p-3 text-[10px] leading-relaxed text-amber-100">The current synthetic graph models one vessel, one crane and one berth selection workflow. No live telemetry, nine executing agents, backend AI chat, or operational dataset beyond this model is implemented yet.</div></aside></section>
      </main></div>;
}
