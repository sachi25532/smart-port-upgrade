import from "..styles.global.css"
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { DashboardSquare01Icon, DeliveryTruck01Icon, UserGroupIcon, Settings01Icon, Notification01Icon, SparklesIcon, Alert01Icon, ChartHistogramIcon }

def:pub PortMindDashboard() -> JsxElement {
    has sim_minute: int = 42,
        playing: bool = True,
        speed: int = 1,
        selected_vessel: str = "MV Ocean Pioneer",
        active_nav: str = "Command Center",
        crane_failed: bool = False,
        replanned: bool = False,
        chat_text: str = "",
        chat_answer: str = "";
    def advance(e: MouseEvent) { sim_minute += 15 * speed; if sim_minute >= 60 { sim_minute -= 60; } }
    def toggle_play(e: MouseEvent) { playing = not playing; }
    def toggle_speed(e: MouseEvent) { speed = 5 if speed == 1 else 1; }
    def select_ocean(e: MouseEvent) { selected_vessel = "MV Ocean Pioneer"; }
    def select_lynx(e: MouseEvent) { selected_vessel = "MV Baltic Lynx"; }
    def select_horizon(e: MouseEvent) { selected_vessel = "MV Horizon Star"; }
    def nav_command(e: MouseEvent) { active_nav = "Command Center"; }
    def nav_vessels(e: MouseEvent) { active_nav = "Live Vessel Tracking"; }
    def nav_berth(e: MouseEvent) { active_nav = "Berth Operations"; }
    def nav_container(e: MouseEvent) { active_nav = "Container Operations"; }
    def nav_cranes(e: MouseEvent) { active_nav = "Cranes & Equipment"; }
    def nav_trucks(e: MouseEvent) { active_nav = "Trucks & Traffic"; }
    def nav_workforce(e: MouseEvent) { active_nav = "Workforce & Shifts"; }
    def nav_environment(e: MouseEvent) { active_nav = "Environment Monitoring"; }
    def nav_ai(e: MouseEvent) { active_nav = "AI Operations Center"; }
    def nav_settings(e: MouseEvent) { active_nav = "Settings"; }
    def fail_crane(e: MouseEvent) { crane_failed = True; }
    def restore_crane(e: MouseEvent) { crane_failed = False; }
    def trigger_plan(e: MouseEvent) { replanned = True; }
    def handle_chat_input(e: ChangeEvent) { chat_text = e.target.value; }
    def ask_ai(e: MouseEvent) { if chat_text.strip() { chat_answer = "Simulation brief: 3 vessels tracked, 2 occupied berths, 1 vessel awaiting assignment. Current synthetic snapshot recommends keeping Berth 03 clear for the next arrival."; chat_text = ""; } }

    return <div className="min-h-screen bg-[#07111d] text-slate-100"><div className="flex min-h-screen">
      <aside className="hidden w-60 shrink-0 flex-col border-r border-slate-800 bg-[#091522] px-3 py-5 xl:flex">
        <div className="mb-8 flex items-center gap-3 px-2"><div className="flex size-10 items-center justify-center rounded-md border border-cyan-400/30 bg-cyan-400/10 text-lg font-bold text-cyan-300">P</div><div><div className="text-sm font-bold tracking-wide">PORTMIND <span className="text-cyan-300">AI</span></div><div className="text-[10px] uppercase tracking-[.18em] text-slate-500">Colombo terminal</div></div></div>
        <div className="mb-2 px-3 text-[10px] font-semibold uppercase tracking-[.16em] text-slate-500">Operations</div>
        <nav className="flex flex-col gap-1">
          <button onClick={nav_command} className="flex items-center gap-3 rounded-md border border-cyan-400/20 bg-cyan-400/10 px-3 py-2.5 text-left text-xs font-medium text-cyan-200"><HugeiconsIcon icon={DashboardSquare01Icon} className="size-4" />Command Center</button>
          <button onClick={nav_vessels} className="rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800">Live Vessel Tracking</button>
          <button onClick={nav_berth} className="rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800">Berth Operations</button>
          <button onClick={nav_container} className="rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800">Container Operations</button>
          <button onClick={nav_cranes} className="rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800">Cranes & Equipment</button>
          <button onClick={nav_trucks} className="flex items-center gap-3 rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800"><HugeiconsIcon icon={DeliveryTruck01Icon} className="size-4" />Trucks & Traffic</button>
          <button onClick={nav_workforce} className="flex items-center gap-3 rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800"><HugeiconsIcon icon={UserGroup01Icon} className="size-4" />Workforce & Shifts</button>
          <button onClick={nav_environment} className="rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800">Environment Monitoring</button>
          <div className="mb-2 mt-6 px-3 text-[10px] font-semibold uppercase tracking-[.16em] text-slate-500">Intelligence</div>
          <button onClick={nav_ai} className="flex items-center gap-3 rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800"><HugeiconsIcon icon={SparklesIcon} className="size-4" />AI Operations Center</button>
          <button onClick={nav_settings} className="flex items-center gap-3 rounded-md px-3 py-2.5 text-left text-xs text-slate-400 hover:bg-slate-800"><HugeiconsIcon icon={Settings01Icon} className="size-4" />Settings</button>
        </nav>
        <div className="mt-auto border-t border-slate-800 pt-4"><div className="flex items-center gap-3 px-2 py-2"><div className="flex size-8 items-center justify-center rounded-full bg-slate-700 text-[10px]">RN</div><div className="min-w-0 flex-1"><div className="text-xs font-medium">R. Nadarajah</div><div className="text-[10px] text-slate-500">Operations controller</div></div><button className="text-[10px] text-slate-500 hover:text-white">Logout</button></div></div>
      </aside>
      <main className="min-w-0 flex-1">
        <header className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 bg-[#091522] px-4 py-3 md:px-6"><div className="flex items-center gap-3"><div className="flex size-8 items-center justify-center rounded border border-cyan-500/30 text-cyan-300 xl:hidden">P</div><div><div className="text-sm font-semibold">Colombo Simulation Terminal</div><div className="text-[10px] text-slate-500">Port operations command network / {active_nav}</div></div></div><div className="flex flex-wrap items-center gap-2 text-[10px]"><div className="flex items-center gap-1.5 rounded border border-emerald-500/20 bg-emerald-500/10 px-2 py-1.5 text-emerald-300"><span className="size-1.5 animate-pulse rounded-full bg-emerald-400" />LIVE SIMULATION</div><div className="rounded border border-slate-700 px-2 py-1.5 text-slate-300">{"SIM 14:" + ("0" if sim_minute < 10 else "") + str(sim_minute) + " UTC"}</div><div className="rounded border border-slate-700 px-2 py-1.5 text-slate-300">28°C <span className="text-slate-500">· SW 12 kt</span></div><button className="flex items-center gap-1 rounded border border-amber-500/30 bg-amber-500/10 px-2 py-1.5 text-amber-300"><HugeiconsIcon icon={Notification01Icon} className="size-3.5" />3 alerts</button><div className="hidden items-center gap-2 border-l border-slate-700 pl-3 sm:flex"><div className="flex size-7 items-center justify-center rounded-full bg-slate-700 text-[9px]">RN</div><span className="text-slate-300">R. Nadarajah</span></div></div></header>
        <div className="space-y-4 p-4 md:p-6">
          <div className="flex flex-wrap items-end justify-between gap-3"><div><div className="mb-1 text-[10px] font-semibold uppercase tracking-[.2em] text-cyan-400">PORT OPERATIONS / SHIFT A</div><h1 className="text-xl font-semibold tracking-tight">Command center</h1><p className="mt-1 text-xs text-slate-400">Synthetic Colombo-inspired terminal overview · operational simulation</p></div><div className="flex items-center gap-1.5 rounded border border-slate-800 bg-[#0c1a29] p-1"><button onClick={toggle_play} className="rounded px-2.5 py-1.5 text-[10px] text-slate-300 hover:bg-slate-700">{"Ⅱ Pause" if playing else "▶ Play"}</button><button onClick={toggle_speed} className="rounded border border-slate-700 px-2 py-1.5 text-[10px] text-cyan-300">{str(speed) + "×"}</button><button onClick={advance} className="rounded bg-cyan-500/15 px-2.5 py-1.5 text-[10px] font-medium text-cyan-200 hover:bg-cyan-500/25">Advance +15m</button></div></div>
          <section className="grid grid-cols-2 gap-2 md:grid-cols-4 2xl:grid-cols-8">
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Total vessels</div><div className="mt-1 text-xl font-semibold tabular-nums">08</div><div className="text-[9px] text-slate-500">3 in port · 5 at sea</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Arriving vessels</div><div className="mt-1 text-xl font-semibold tabular-nums text-cyan-300">03</div><div className="text-[9px] text-slate-500">Next ETA 15:20</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Vessels waiting</div><div className="mt-1 text-xl font-semibold tabular-nums text-amber-300">01</div><div className="text-[9px] text-slate-500">Anchorage A · 42 min</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Occupied berths</div><div className="mt-1 text-xl font-semibold tabular-nums">02<span className="text-sm text-slate-500"> / 03</span></div><div className="text-[9px] text-slate-500">Berth 03 available</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Available cranes</div><div className="mt-1 text-xl font-semibold tabular-nums text-emerald-300">06<span className="text-sm text-slate-500"> / 08</span></div><div className="text-[9px] text-slate-500">{"QC-04 FAULT" if crane_failed else "QC-04 online"}</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Active trucks</div><div className="mt-1 text-xl font-semibold tabular-nums">34</div><div className="text-[9px] text-amber-300">Gate queue 6</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">On-duty workers</div><div className="mt-1 text-xl font-semibold tabular-nums">126</div><div className="text-[9px] text-slate-500">Shift A · 82% staffed</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="text-[10px] text-slate-500">Yard occupancy</div><div className="mt-1 text-xl font-semibold tabular-nums">72%</div><div className="mt-2 h-1 rounded bg-slate-700"><div className="h-1 w-[72%] rounded bg-cyan-400" /></div></div>
          </section>
          <section className="grid min-w-0 gap-4 2xl:grid-cols-[minmax(0,1fr)_300px]">
            <div className="overflow-hidden rounded border border-slate-800 bg-[#0b1927]"><div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 px-4 py-3"><div><h2 className="text-xs font-semibold tracking-wide">LIVE VESSEL TRACKING</h2><p className="mt-1 text-[9px] text-slate-500">Synthetic Colombo-inspired terminal schematic · not verified geographic data</p></div><div className="flex items-center gap-3 text-[9px] text-slate-400"><span><i className="mr-1 inline-block size-1.5 rounded-full bg-cyan-400" />Arriving</span><span><i className="mr-1 inline-block size-1.5 rounded-full bg-emerald-400" />Alongside</span><span><i className="mr-1 inline-block size-1.5 rounded-full bg-amber-400" />Waiting</span></div></div>
              <div className="relative h-[350px] overflow-hidden bg-[#0a2434] md:h-[410px]"><div className="absolute inset-0 opacity-30" style={{"backgroundImage":"linear-gradient(rgba(68,140,166,.16) 1px, transparent 1px),linear-gradient(90deg,rgba(68,140,166,.16) 1px,transparent 1px)","backgroundSize":"36px 36px"}} /><div className="absolute -left-16 top-20 h-44 w-[62%] rotate-[-13deg] rounded-[50%] border border-cyan-800/30 bg-[#0c3042]/60" /><div className="absolute left-[6%] top-[11%] rounded border border-slate-700 bg-[#0d1c28]/85 px-2 py-1 text-[9px] uppercase tracking-wider text-slate-400">Approach channel</div><div className="absolute left-[8%] top-[43%] h-px w-[47%] rotate-[-13deg] border-t border-dashed border-cyan-400/50" /><div className="absolute left-[7%] top-[29%] rounded border border-amber-400/30 bg-amber-400/10 px-2 py-1 text-[9px] text-amber-200">ANCHORAGE A</div>
                <button onClick={select_lynx} className="absolute left-[20%] top-[40%] rounded border border-cyan-400/40 bg-[#0b2030] px-2.5 py-1.5 text-left shadow-lg"><span className="block text-[9px] font-semibold text-cyan-200">MV Baltic Lynx</span><span className="text-[8px] text-slate-400">Inbound · 6.2 kn</span></button><button onClick={select_horizon} className="absolute left-[7%] top-[30%] rounded border border-amber-400/40 bg-[#0b2030] px-2.5 py-1.5 text-left"><span className="block text-[9px] font-semibold text-amber-200">MV Horizon Star</span><span className="text-[8px] text-slate-400">Awaiting berth · 42m</span></button>
                <div className="absolute right-[10%] top-[10%] h-[77%] w-[39%] border-l border-slate-600/70 bg-[#182a34]/90"><div className="absolute -left-2 top-[17%] h-12 w-[102%] border border-slate-600 bg-[#26343c]"><span className="absolute left-3 top-3 text-[9px] font-semibold tracking-widest text-slate-300">BERTH 01</span><span className="absolute right-3 top-3 text-[8px] text-emerald-300">OCCUPIED</span></div><div className="absolute -left-2 top-[43%] h-12 w-[102%] border border-slate-600 bg-[#26343c]"><span className="absolute left-3 top-3 text-[9px] font-semibold tracking-widest text-slate-300">BERTH 02</span><span className="absolute right-3 top-3 text-[8px] text-emerald-300">OCCUPIED</span></div><div className="absolute -left-2 top-[69%] h-12 w-[102%] border border-dashed border-cyan-500/50 bg-cyan-500/5"><span className="absolute left-3 top-3 text-[9px] font-semibold tracking-widest text-cyan-200">BERTH 03</span><span className="absolute right-3 top-3 text-[8px] text-cyan-300">AVAILABLE</span></div><div className="absolute -right-2 top-[5%] flex h-[83%] w-2 flex-col justify-around">{for crane in [1,2,3,4,5,6] { <span key={str(crane)} className="h-5 w-5 border-l-2 border-t-2 border-cyan-500/80" /> }}</div><div className="absolute bottom-2 left-3 text-[8px] uppercase tracking-wider text-slate-500">Container terminal · QC cranes</div></div><button onClick={select_ocean} className="absolute right-[43%] top-[23%] rounded border border-emerald-400/50 bg-[#0b2030] px-2.5 py-1.5 text-left"><span className="block text-[9px] font-semibold text-emerald-200">MV Ocean Pioneer</span><span className="text-[8px] text-slate-400">Alongside · Berth 01</span></button><div className="absolute bottom-3 left-3 flex items-center gap-2 rounded border border-slate-700 bg-[#081622]/90 px-2.5 py-1.5 text-[8px] text-slate-400"><span className="size-1.5 rounded-full bg-cyan-400" />Route trail · Scale schematic</div><div className="absolute right-3 top-3 rounded border border-slate-700 bg-[#081622]/80 px-2 py-1 text-[8px] text-slate-400">N ↑</div></div>
              <div className="grid gap-0 border-t border-slate-800 sm:grid-cols-[1.15fr_1fr_1fr]"><div className="border-b border-slate-800 p-3 sm:border-b-0 sm:border-r"><div className="mb-2 flex items-center justify-between"><span className="text-[9px] uppercase tracking-wider text-slate-500">Selected vessel</span><button onClick={select_ocean} className="text-[9px] text-cyan-300">View vessel</button></div><div className="text-xs font-semibold">{selected_vessel}</div><div className="mt-1 text-[9px] text-slate-400">{"Alongside · Berth 01" if selected_vessel == "MV Ocean Pioneer" else "Inbound · Anchorage approach"}</div><div className="mt-2 grid grid-cols-2 gap-2 text-[9px]"><span className="text-slate-500">ETA / status</span><span className="text-right text-slate-300">15:20 / {"Alongside" if selected_vessel == "MV Ocean Pioneer" else "Inbound"}</span><span className="text-slate-500">Assignment</span><span className="text-right text-slate-300">{"Berth 01 · QC-02, 03" if selected_vessel == "MV Ocean Pioneer" else "Berth 03 · pending"}</span></div></div><div className="border-b border-slate-800 p-3 sm:border-b-0 sm:border-r"><div className="flex justify-between text-[9px]"><span className="text-slate-500">Cargo operation</span><span className="text-cyan-300">64%</span></div><div className="mt-2 h-1.5 rounded bg-slate-700"><div className="h-1.5 w-[64%] rounded bg-cyan-400" /></div><div className="mt-2 flex justify-between text-[9px] text-slate-400"><span>4,820 / 7,500 TEU</span><span>ETD 19:40</span></div></div><div className="p-3"><div className="mb-2 text-[9px] uppercase tracking-wider text-slate-500">Vessel status</div><div className="flex items-center gap-2 text-[10px]"><span className="size-1.5 rounded-full bg-emerald-400" />Operational</div><div className="mt-2 text-[9px] text-slate-500">Waiting time <span className="float-right text-slate-300">42 min</span></div><div className="mt-2 text-[9px] text-slate-500">Coordinates <span className="float-right text-slate-300">6.93°N 79.84°E*</span></div></div></div>
            </div>
            <aside className="flex flex-col gap-3"><section className="rounded border border-slate-800 bg-[#0c1a29]"><div className="flex items-center justify-between border-b border-slate-800 px-3 py-2.5"><h2 className="text-[10px] font-semibold tracking-wide">OPERATIONS QUEUE</h2><button className="text-[9px] text-cyan-300">All events</button></div><div className="divide-y divide-slate-800/80"><div className="px-3 py-2.5"><div className="flex justify-between"><span className="text-[10px] font-medium">MV Baltic Lynx</span><span className="text-[9px] text-cyan-300">ETA 15:20</span></div><div className="mt-1 text-[9px] text-slate-500">Inbound · Berth 03 candidate</div></div><div className="px-3 py-2.5"><div className="flex justify-between"><span className="text-[10px] font-medium">Next berth release</span><span className="text-[9px] text-emerald-300">19:40</span></div><div className="mt-1 text-[9px] text-slate-500">Berth 01 · Ocean Pioneer</div></div><div className="px-3 py-2.5"><div className="flex justify-between"><span className="text-[10px] font-medium">Crane QC-04</span><span className="text-[9px] text-amber-300">{"FAILED" if crane_failed else "Inspect"}</span></div><div className="mt-1 text-[9px] text-slate-500">{"Breakdown simulated · service required" if crane_failed else "Vibration alert · review scheduled"}</div><button onClick={restore_crane if crane_failed else fail_crane} className="mt-2 rounded border border-slate-700 px-2 py-1 text-[9px] text-slate-300 hover:border-cyan-500/50">{"Restore equipment" if crane_failed else "Simulate breakdown"}</button></div></div></section>
              <section className="rounded border border-cyan-900/60 bg-[#0c1a29]"><div className="flex items-center gap-2 border-b border-slate-800 px-3 py-2.5"><HugeiconsIcon icon={SparklesIcon} className="size-3.5 text-cyan-300" /><h2 className="text-[10px] font-semibold tracking-wide">AI PLANNING DESK</h2><span className="ml-auto rounded bg-cyan-400/10 px-1.5 py-0.5 text-[8px] text-cyan-200">9 agents</span></div><div className="p-3"><div className="flex gap-2"><span className="mt-1 size-1.5 shrink-0 rounded-full bg-amber-400" /><div><div className="text-[10px] font-medium">Berth allocation proposal</div><p className="mt-1 text-[9px] leading-relaxed text-slate-400">Assign Baltic Lynx to Berth 03 to avoid a 38 min anchorage delay.</p></div></div><div className="mt-3 flex items-center justify-between"><span className="text-[8px] text-slate-500">Draft · requires controller review</span><button onClick={trigger_plan} className="rounded bg-cyan-500/15 px-2 py-1 text-[9px] text-cyan-200">{replanned ? "Plan refreshed" : "Replan operations"}</button></div>{replanned and <div className="mt-2 rounded border border-emerald-500/20 bg-emerald-500/5 p-2 text-[9px] text-emerald-200">Synthetic replan complete. Berth 03 remains the lowest-delay candidate; no schedule committed.</div>}</div></section>
              <section className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="mb-2 flex items-center justify-between"><h2 className="text-[10px] font-semibold">ASK PORTMIND AI</h2><span className="text-[8px] text-slate-500">Snapshot grounded</span></div><div className="flex gap-1.5"><input value={chat_text} onChange={handle_chat_input} placeholder="Ask about this simulation..." className="min-w-0 flex-1 rounded border border-slate-700 bg-[#081622] px-2 py-1.5 text-[9px] text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-500/60" /><button onClick={ask_ai} className="rounded bg-cyan-500/15 px-2 text-[9px] text-cyan-200">Ask</button></div>{chat_answer and <p className="mt-2 border-l border-cyan-500/50 pl-2 text-[9px] leading-relaxed text-slate-300">{chat_answer}</p>}</section></aside>
          </section>
          <section className="grid gap-3 md:grid-cols-2 2xl:grid-cols-4"><div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="mb-3 flex items-center justify-between"><div><div className="text-[10px] font-semibold">Berth occupancy</div><div className="text-[9px] text-slate-500">Current shift · projected windows</div></div><HugeiconsIcon icon={ChartHistogramIcon} className="size-4 text-cyan-400" /></div><div className="flex h-16 items-end gap-1">{for (i, h) in enumerate([40,55,45,72,62,80,68,91,74,62,78,54]) { <div key={str(i)} className="flex-1 rounded-t-sm bg-cyan-500/50" style={{"height":str(h) + "%"}} /> }}</div><div className="mt-2 flex justify-between text-[8px] text-slate-500"><span>14:00</span><span>16:00</span><span>18:00</span><span>20:00</span></div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="mb-3 flex items-center justify-between"><div><div className="text-[10px] font-semibold">Crane utilization</div><div className="text-[9px] text-slate-500">6 active · 1 standby · 1 alert</div></div><span className="text-xs font-semibold text-cyan-300">78%</span></div><div className="flex h-16 items-end gap-1">{for (i, h) in enumerate([56,70,64,82,74,92,66,78,51,86,69,76]) { <div key={str(i)} className="flex-1 rounded-t-sm bg-blue-500/50" style={{"height":str(h) + "%"}} /> }}</div><div className="mt-2 text-[8px] text-slate-500">QC-01 to QC-08 · 15 minute intervals</div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="mb-3 flex items-center justify-between"><div><div className="text-[10px] font-semibold">Truck gate flow</div><div className="text-[9px] text-slate-500">34 active · 6 queued</div></div><span className="rounded bg-amber-500/10 px-1.5 py-1 text-[8px] text-amber-300">MODERATE</span></div><div className="flex h-16 items-end gap-1">{for (i, h) in enumerate([32,44,38,58,53,66,60,72,46,55,40,49]) { <div key={str(i)} className="flex-1 rounded-t-sm bg-amber-500/50" style={{"height":str(h) + "%"}} /> }}</div><div className="mt-2 flex justify-between text-[8px] text-slate-500"><span>Gate A · 4</span><span>Gate B · 2</span><span>Avg wait · 11m</span></div></div>
            <div className="rounded border border-slate-800 bg-[#0c1a29] p-3"><div className="mb-3 flex items-center justify-between"><div><div className="text-[10px] font-semibold">Shift & incidents</div><div className="text-[9px] text-slate-500">Workforce / event log</div></div><HugeiconsIcon icon={Alert01Icon} className="size-4 text-amber-300" /></div><div className="flex items-center gap-3"><div className="text-2xl font-semibold tabular-nums">126<span className="text-xs text-slate-500"> / 154</span></div><div className="text-[9px] text-slate-500">workers on duty<br />Shift A · 82% rostered</div></div><div className="mt-2 border-t border-slate-800 pt-2 text-[9px] text-slate-400">14:36 <span className="text-amber-300">QC-04 vibration alert</span></div></div></section>
          <div className="flex flex-wrap items-center justify-between gap-2 border-t border-slate-800 pt-3 text-[9px] text-slate-600"><span>PortMind AI · Colombo Simulation Terminal · Synthetic operational data</span><span>Illustrative metrics · no live port feeds connected</span></div>
        </div>
      </main>
    </div></div>;
}
